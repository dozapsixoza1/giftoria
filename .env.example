# Required to verify Telegram Mini App initData and query Bot API
TELEGRAM_BOT_TOKEN=
# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=
# Public publishable key (safe for browser use; server persistence uses service role)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret from Supabase Project Settings > API Keys > service_role / secret
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Telegram numeric user IDs allowed to access admin endpoints
ADMIN_TELEGRAM_IDS=
